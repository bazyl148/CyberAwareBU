+async def _defend_retrieval(
+    results: list[dict], query: str, level: int, user_id: int | None
+) -> list[dict]:
+    """Run the rag.kb retrieval controls for ``level`` over raw KB hits.
+
+    Returns only the hits the controls left in context, so the prompt and the
+    evaluator's ``kb_entries_used`` both reflect what the model actually saw.
+    """
+    profile = resolve_profile("rag.kb", level)
+    control_ids = tuple(
+        cid for cid in profile.controls
+        if DefenseStage.RETRIEVAL in get_control(cid).applies_to
+    )
+    candidates = [dict(r, included_in_context=True) for r in results]
+    decision = DefenseDecision(
+        surface="rag.kb",
+        stage=DefenseStage.RETRIEVAL,
+        payload=query,
+        level=level,
+        user_id=user_id,
+        context={"candidates": candidates, "query": query},
+    )
+    await run_chain(control_ids, decision)
+    kept = decision.context.get("candidates") or candidates
+    return [
+        c for c in kept
+        if c.get("included_in_context") and not c.get("excluded_by_control")
+    ]
+
+
