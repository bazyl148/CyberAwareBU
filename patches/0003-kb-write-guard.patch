+def _kb_write_guard(user: User) -> bool:
+    """CyberAware P3: whether this user's KB writes are restricted.
+
+    Non-staff users cannot choose trust_tier or owner_id, and can only edit
+    entries they own. On by default; CYBERAWARE_KB_WRITE_GUARD=0 restores the
+    stock, spoofable behaviour that the trust-tier lab relies on.
+    """
+    enabled = os.environ.get("CYBERAWARE_KB_WRITE_GUARD", "1") != "0"
+    return enabled and not user.is_staff
+
